# Supply-chain: refuse to resolve npm versions published less than 7 days ago.
#
# Compromised packages are typically yanked within hours-to-days of publication,
# so a release-age window means a malicious version is usually gone before we
# would ever resolve it. 7 days clears the observed detection window with margin
# while staying short enough that security patches are not stalled for long.
#
# Scope: this gates *resolution* only — `npm install`, `npm update`, and anything
# else that writes package-lock.json. `npm ci` installs exactly what the lockfile
# pins and ignores this setting, so the Docker build is unaffected (its node:22
# base ships npm 10.x, which predates the option anyway). The gate does its work
# here, at the point where a new version first enters the lockfile.
#
# Requires npm >= 11.6.1. Bypass for a specific urgent upgrade with
# `npm install <pkg> --min-release-age=0`; exempt a package permanently with
# min-release-age-exclude[]=<name>.
min-release-age=7
